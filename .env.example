# Copy this file to .env in the backend project folder.
# These credentials are only for the local development database.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=bookstore
POSTGRES_USER=bookstore
POSTGRES_PASSWORD=bookstore_dev

# Exact Vue development server origin (no trailing slash).
FRONTEND_ORIGIN=http://localhost:5173

# Local sample catalog. Leave this unset in production and hosted CI.
SPRING_PROFILES_ACTIVE=dev

# Optional: create a separate administrator on startup. Disabled unless explicitly enabled.
# Remove these settings after the first successful startup. Never commit a real password.
# APP_ADMIN_BOOTSTRAP_ENABLED=true
# APP_ADMIN_BOOTSTRAP_EMAIL=
# APP_ADMIN_BOOTSTRAP_USERNAME=Administrator
# APP_ADMIN_BOOTSTRAP_PASSWORD=
